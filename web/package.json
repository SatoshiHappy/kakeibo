{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:setup": "wrangler d1 migrations apply kakeibo --local && wrangler d1 execute kakeibo --local --command \"INSERT OR IGNORE INTO users (email, display_name, created_at) VALUES ('dev@example.com', '開発', '2026-01-01T00:00:00Z')\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node scripts/check-table-rows.mjs && vitest run && vitest run -c vitest.web.config.ts",
    "check:tables": "node scripts/check-table-rows.mjs",
    "typecheck": "tsc -b",
    "e2e": "playwright test && playwright test -c playwright.preview.config.ts",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.105",
    "@ai-sdk/google": "^4.0.121",
    "@block65/webcrypto-web-push": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "ai": "^7.0.173",
    "hono": "^4.13.18",
    "idb-keyval": "^6.3.0",
    "jose": "^6.2.17",
    "papaparse": "^5.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  }
}
